{
  "manifest_version": 3,
  "name": "Zendesk Autofill (Oslo kommune)",
  "version": "0.1.0",
  "description": "Prefills required ticket fields and reply recipient in Zendesk.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zendesk Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.zendesk.com/agent/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
